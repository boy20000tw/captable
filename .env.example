# Database (PostgreSQL — self-hosted on Zeabur Tokyo; TLS on, self-signed)
DATABASE_URL=postgresql://user:password@HOST:PORT/caploom

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_xxxxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# Vercel Blob Storage (for document uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxx

# Email Notifications (Resend)
RESEND_API_KEY=re_xxxxx

# Server
NODE_ENV=development
PORT=3000

# Rate limiting (self-hosted Redis, optional — limiter is skipped when unset)
REDIS_URL=redis://default:password@HOST:PORT
